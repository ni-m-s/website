    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --text:  #1a1916;
      --muted: #6b6860;
      --faint: #c8c4bc;
      --bg:    #faf9f7;
    }

    body {
      background: var(--bg);
      color: var(--text);
