      font-weight: 400;
      letter-spacing: 0.01em;
      line-height: 1.2;
      margin-bottom: 2.2rem;
    }

    .epigraph {
      margin-bottom: 3.5rem;
      padding-left: 1.5rem;
      border-left: 1px solid var(--faint);
    }

    .epigraph p {
      font-style: italic;
      font-size: 1.05rem;
      color: var(--muted);
      line-height: 1.6;
    }

    .epigraph cite {
      display: block;
      margin-top: 0.4rem;
      font-style: normal;
      font-size: 0.82rem;
      letter-spacing: 0.04em;
      color: var(--faint);
    }

    .body-text {
      margin-bottom: 1.1rem;
    }

    .body-text:last-of-type { margin-bottom: 0; }

    section {
      margin-top: 3.2rem;
    }

    h2 {
      font-size: 0.72rem;
      font-weight: 400;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 1.4rem;
    }

    .pub {
      margin-bottom: 1.4rem;
      padding-bottom: 1.4rem;
      border-bottom: 1px solid var(--faint);
    }

    .pub:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .pub-title {
      display: block;
      font-size: 1.05rem;
      line-height: 1.55;
      margin-bottom: 0.2rem;
    }

    .pub-authors {
      font-size: 0.88rem;
      color: var(--muted);
      font-style: italic;
    }

    .pub-ref {
      display: block;
      font-size: 0.85rem;
      color: var(--muted);
      margin-top: 0.15rem;
    }

    .talk {
      display: grid;
      grid-template-columns: 2.8rem 1fr;
      gap: 0 0.8rem;
      margin-bottom: 0.9rem;
      font-size: 0.95rem;
    }

    .talk:last-child { margin-bottom: 0; }

    .talk-year {
      color: var(--muted);
      font-size: 0.82rem;
      padding-top: 0.18rem;
    }

    .talk-body { line-height: 1.55; }

    .talk-where {
      font-size: 0.85rem;
      color: var(--muted);
    }

    .talk-title {
      font-style: italic;
      color: var(--muted);
      font-size: 0.85rem;
    }

    .contact {
      font-size: 0.88rem;
      color: var(--muted);
      margin-top: 3.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--faint);
    }
  </style>
</head>
